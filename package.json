{
  "name": "@boringnode/queue",
  "description": "A simple and efficient queue system for Node.js applications",
  "version": "0.8.0",
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./otel": "./build/src/otel.js",
    "./drivers/fake_adapter": "./build/src/drivers/fake_adapter.js",
    "./drivers/knex_adapter": "./build/src/drivers/knex_adapter.js",
    "./drivers/kysely_adapter": "./build/src/drivers/kysely_adapter.js",
    "./drivers/redis_adapter": "./build/src/drivers/redis_adapter.js",
    "./drivers/sync_adapter": "./build/src/drivers/sync_adapter.js",
    "./contracts/adapter": "./build/src/contracts/adapter.js",
    "./types": "./build/src/types/index.js"
  },
  "scripts": {
    "benchmark": "node --import=@poppinss/ts-exec benchmark/run.ts",
    "benchmark:quick": "node --import=@poppinss/ts-exec benchmark/run.ts --quick",
    "benchmark:full": "node --import=@poppinss/ts-exec benchmark/run.ts --full",
    "build": "yarn clean && tsup-node",
    "clean": "del-cli build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "prepublishOnly": "yarn build",
    "release": "release-it",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts --reporters=dot",
    "test:coverage": "c8 yarn test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lukeed/ms": "^2.0.2",
    "@poppinss/utils": "^7.1.2",
    "cron-parser": "^5.10.2"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.79.2",
    "c8": "^12.0.0",
    "del-cli": "^8.0.1",
    "hot-hook": "^1.0.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pg": "^8.23.1",
    "release-it": "^21.1.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.0 || ^2.0.0",
    "@opentelemetry/instrumentation": ">=0.200.0 <0.300.0",
    "ioredis": "^5.0.0 || ^6.0.0",
    "knex": "^3.0.0",
    "kysely": "^0.29.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/core": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "license": "MIT",
  "homepage": "https://github.com/boringnode/queue#readme",
  "bugs": {
    "url": "https://github.com/boringnode/queue/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boringnode/queue.git"
  },
  "keywords": [
    "queue",
    "job",
    "task",
    "worker",
    "redis"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "release-it": {
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "preMajor": true
        }
      }
    },
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
